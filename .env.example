# The deployed pepper-carrot-mcp server (Streamable HTTP). Required.
# Same server the eval and Claude connect to — the red-teamer is just another client.
MCP_SERVER_URL=https://pepper-carrot-mcp.fly.dev/mcp

# The agent loop (tool use) and the fuzzy-verdict judge. Required to run.
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-4-8
JUDGE_MODEL=claude-sonnet-4-6
# Cheap transform for the injection `language` (translate) option.
TRANSLATE_MODEL=claude-haiku-4-5

# Budget governor — agentic loops are unbounded by default, so cap them.
MAX_TURNS=12
MAX_TOOL_CALLS=25
MAX_USD=0.50
# Stop a run after this many turns with no new confirmed failure (stall detector).
STALL_PATIENCE=3

# Default reading position the spoiler probes attack (the server enforces the real boundary).
TARGET_EPISODE=2
TARGET_PAGE=3

# Where confirmed failures are written back as candidate gold for the evaluator.
# Point this at a checkout of pepper-carrot-eval to close the loop.
EVAL_GOLD_DIR=../pepper-carrot-eval/data
